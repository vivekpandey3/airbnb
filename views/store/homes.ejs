<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
        All Homes
      </h2>
      <div class="flex flex-wrap justify-center gap-6">
        <% if (registeredHomes && registeredHomes.length > 0) { %>
          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300 w-full max-w-sm">
             <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-12 h-48 object-cover">
              <div class="p-4">
                <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= home.houseName %></h3>
                <p class="text-gray-600 mb-2"><i class="fas fa-map-marker-alt mr-2"></i><%= home.location %></p>
                <div class="flex justify-between items-center mb-2">
                  <span class="text-lg font-bold text-red-500">Rs<%= home.price %> / night</span>
                  <div class="flex items-center">
                    <% for (let i = 0; i < Number(home.rating); i++) { %>
                      <span style="color: gold; font-size: 1.2em;">★</span>
                    <% } %>
                    <% for (let i = Number(home.rating); i < 5; i++) { %>
                      <span style="color: #ccc; font-size: 1.2em;">☆</span>
                    <% } %>
                  </div>
                </div>
                <%- include('../partials/favorite', {home: home}) %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-center text-gray-500">No homes found.</p>
        <% } %>
      </div>
    </main>
  </body>
</html>
