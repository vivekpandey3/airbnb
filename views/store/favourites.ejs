<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="container mx-auto mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (favouriteHomes && favouriteHomes.length > 0) { %>
      <% favouriteHomes.forEach(home => { %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
         <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-12 h-48 object-cover">
          <div class="p-4">
            <h3 class="text-xl font-semibold mb-2"><%= home.houseName %></h3>
            <p class="text-gray-600 mb-2"><i class="fas fa-map-marker-alt mr-2"></i><%= home.location %></p>
            <p class="text-lg font-bold text-red-500 mb-2">Rs <%= home.price %> / night</p>
            <p class="text-gray-700 mb-2">Rating: <%= home.rating %></p>

            <form action="/favourites/delete/<%= home.id %>" method="POST">
              <button class="bg-red-300 px-3 py-1 rounded hover:bg-red-400">Remove Favourite</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-center text-gray-500 col-span-full">No favourites found.</p>
    <% } %>
  </main>
</body>
</html>
