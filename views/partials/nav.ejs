<header class="bg-red-500 text-white p-4 shadow-md sticky top-0 z-10">
  <nav class="container mx-auto flex flex-wrap justify-between items-center">
    
    <!-- Left Links (Logo + Main Links) -->
    <ul class="flex flex-wrap items-center gap-2 md:gap-1">
      <li>
        <a href="/" class="<%= currentPage === 'index' ? 'bg-red-600 font-medium' : 'hover:bg-red-400' %> py-2 px-4 rounded-lg transition duration-300 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-1">
            <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
            <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
          </svg>
          airbnb
        </a>
      </li>

      <% if (isLoggedIn && user.userType === 'guest') { %>
        <li><a href="/homes" class="py-2 px-4 rounded-lg hover:bg-red-400 transition">Homes</a></li>
        <li><a href="/favourites" class="py-2 px-4 rounded-lg hover:bg-red-400 transition">Favourites</a></li>
        <li><a href="/bookings" class="py-2 px-4 rounded-lg hover:bg-red-400 transition">Bookings</a></li>
      <% } else if (isLoggedIn && user.userType === 'host') { %>
        <li><a href="/host/host-home-list" class="py-2 px-4 rounded-lg hover:bg-red-400 transition">Host Homes</a></li>
        <li><a href="/host/add-home" class="py-2 px-4 rounded-lg hover:bg-red-400 transition">Add Home</a></li>
      <% } %>
    </ul>

    <!-- Right Links (Login/Signup/Logout) -->
    <ul class="flex flex-wrap gap-2 md:gap-2 items-center mt-2 md:mt-0">
      <% if (!isLoggedIn) { %>
        <li>
          <a href="/signup" class="py-2 px-4 rounded-lg border border-white hover:bg-red-400 transition">Sign Up</a>
        </li>
        <li>
          <a href="/login" class="py-2 px-4 rounded-lg bg-white text-red-500 hover:bg-red-50 transition">Login</a>
        </li>
      <% } else { %>
        <li>
          <form action="/logout" method="POST">
            <button type="submit" class="py-2 px-4 rounded-lg border border-white hover:bg-red-400 transition">
              Logout
            </button>
          </form>
        </li>
      <% } %>
    </ul>

  </nav>
</header>
